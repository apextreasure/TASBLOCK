{
  "name": "tasblock",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/videos/*", "!/tasblock-logo*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
